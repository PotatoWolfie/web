{
  "multipart": [
    {
      "when": { "stage": "old" },
      "apply": { "model": "web:block/spider_egg_old" }
    },
    {
      "when": { "stage": "active" },
      "apply": { "model": "web:block/spider_egg" }
    },
    {
      "when": { "stage": "decayed", "covered": "false" },
      "apply": { "model": "web:block/spider_egg_decayed" }
    },
    {
      "when": { "stage": "decayed", "covered": "true" },
      "apply": { "model": "web:block/spider_egg" }
    }
  ]
}